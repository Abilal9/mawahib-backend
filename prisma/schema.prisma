// Phase 1–4 schema. See docs/MVP_MASTER_BLUEPRINT.md for marketplace contracts.
// Phase 4: Connections, Messaging, Notifications. Marketplace remains frozen.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  talent
  business
}

enum MediaStatus {
  pending
  ready
  failed
}

enum MediaPurpose {
  avatar
  portfolio
  service
  message
}

enum ConnectionRequestStatus {
  pending
  accepted
  rejected
  cancelled
}

enum ConversationType {
  connection
  work
  support
}

enum MessageKind {
  user
  system
}

enum NotificationType {
  connection_request
  connection_accepted
  message_received
  engagement_status
  work_request_event
  system
}

enum ServiceOfferingStatus {
  draft
  published
  archived
}

enum PackageTier {
  basic
  standard
  premium
}

enum EmploymentType {
  full_time
  part_time
  contract
  freelance
  gig
}

enum JobListingStatus {
  draft
  open
  archived
  closed
  in_progress
  completed
  expired
}

enum JobApplicationStatus {
  submitted
  under_review
  accepted
  rejected
  withdrawn
}

enum WorkEngagementStatus {
  requested
  accepted
  declined
  cancelled
  pending_payment
  payment_failed
  in_progress
  delivered
  disputed
  completed
}

enum WorkEngagementSource {
  listing_application
  service_request
  direct
}

enum WorkRequestSource {
  job_posting
  service_request
  direct_request
}

enum WorkRequestStatus {
  pending
  changes_requested
  changes_declined
  pending_payment
  rejected
  withdrawn
}

enum WorkRequestEventType {
  created
  changes_requested
  changes_accepted
  changes_declined
  changes_cancelled
  accepted
  rejected
  withdrawn
  viewed
  listing_closed
  note
}

model User {
  id             String      @id @db.Uuid
  email          String      @unique @db.Citext
  accountType    AccountType @map("account_type")
  displayName    String      @map("display_name")
  username       String      @unique @db.Citext
  isVerified     Boolean     @default(false) @map("is_verified")
  followersCount Int         @default(0) @map("followers_count")
  followingCount Int         @default(0) @map("following_count")
  postsCount     Int         @default(0) @map("posts_count")
  ratingAvg      Decimal     @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount    Int         @default(0) @map("rating_count")
  deletedAt      DateTime?   @map("deleted_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  profile                Profile?
  skills                 UserSkill[]
  mediaAssets            MediaAsset[]
  portfolioProjects      PortfolioProject[]
  serviceOfferings       ServiceOffering[]
  jobListings            JobListing[]       @relation("JobListingPoster")
  jobApplications        JobApplication[]   @relation("JobApplicationApplicant")
  engagementsAsClient    WorkEngagement[]   @relation("EngagementClient")
  engagementsAsProvider  WorkEngagement[]   @relation("EngagementProvider")
  engagementReviews      EngagementReview[] @relation("EngagementReviewer")
  workRequestsSent       WorkRequest[]      @relation("WorkRequestSender")
  workRequestsReceived   WorkRequest[]      @relation("WorkRequestRecipient")
  workRequestsAsClient   WorkRequest[]      @relation("WorkRequestClient")
  workRequestsAsProvider WorkRequest[]      @relation("WorkRequestProvider")

  connectionRequestsSent     ConnectionRequest[]      @relation("ConnectionRequestFrom")
  connectionRequestsReceived ConnectionRequest[]      @relation("ConnectionRequestTo")
  connectionsAsLow           Connection[]             @relation("ConnectionUserLow")
  connectionsAsHigh          Connection[]             @relation("ConnectionUserHigh")
  conversationParticipants   ConversationParticipant[]
  messagesSent               Message[]                @relation("MessageSender")
  notificationsReceived      Notification[]           @relation("NotificationRecipient")
  notificationsAsActor       Notification[]           @relation("NotificationActor")

  @@index([accountType])
  @@map("users")
}

model Profile {
  userId          String   @id @map("user_id") @db.Uuid
  bio             String   @default("")
  title           String?
  locationCity    String?  @map("location_city")
  locationCountry String?  @map("location_country")
  avatarUrl       String?  @map("avatar_url")
  coverUrl        String?  @map("cover_url")
  /// E.164 phone, e.g. +9665xxxxxxx — unique when set
  phoneE164       String?  @unique @map("phone_e164")
  phoneVerified   Boolean  @default(false) @map("phone_verified")
  /// Synced from Supabase Auth email confirmation
  emailVerified   Boolean  @default(false) @map("email_verified")
  /// Optional structured about sections (languages, education, experience, certifications)
  aboutJson       Json?    @map("about_json")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model UserSkill {
  userId    String   @map("user_id") @db.Uuid
  skill     String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, skill])
  @@index([skill])
  @@map("user_skills")
}

model MediaAsset {
  id        String       @id @default(uuid()) @db.Uuid
  ownerId   String       @map("owner_id") @db.Uuid
  bucket    String
  objectKey String       @map("object_key")
  mimeType  String       @map("mime_type")
  byteSize  BigInt       @map("byte_size")
  width     Int?
  height    Int?
  purpose   MediaPurpose
  status    MediaStatus  @default(pending)
  deletedAt DateTime?    @map("deleted_at")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  owner              User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  portfolioMedia     PortfolioMedia[]
  serviceMedia       ServiceMedia[]
  messageAttachments MessageAttachment[]

  @@unique([bucket, objectKey])
  @@index([ownerId, status])
  @@map("media_assets")
}

model PortfolioProject {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  title       String
  description String    @default("")
  position    Int       @default(0)
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  media PortfolioMedia[]

  @@index([userId, position])
  @@map("portfolio_projects")
}

model PortfolioMedia {
  id           String   @id @default(uuid()) @db.Uuid
  projectId    String   @map("project_id") @db.Uuid
  mediaAssetId String   @map("media_asset_id") @db.Uuid
  position     Int
  isVideo      Boolean  @default(false) @map("is_video")
  createdAt    DateTime @default(now()) @map("created_at")

  project    PortfolioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset       @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@unique([projectId, mediaAssetId])
  @@index([projectId, position])
  @@map("portfolio_media")
}

model ServiceOffering {
  id          String                @id @default(uuid()) @db.Uuid
  userId      String                @map("user_id") @db.Uuid
  title       String
  description String                @default("")
  category    String?
  status      ServiceOfferingStatus @default(published)
  ratingAvg   Decimal               @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount Int                   @default(0) @map("rating_count")
  currency    String                @default("SAR") @db.Char(3)
  position    Int                   @default(0)
  deletedAt   DateTime?             @map("deleted_at")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  packages     ServicePackage[]
  addons       ServiceAddon[]
  media        ServiceMedia[]
  engagements  WorkEngagement[]
  workRequests WorkRequest[]

  @@index([userId, status])
  @@index([userId, position])
  @@map("service_offerings")
}

model ServicePackage {
  id            String      @id @default(uuid()) @db.Uuid
  offeringId    String      @map("offering_id") @db.Uuid
  tier          PackageTier
  price         Decimal     @db.Decimal(12, 2)
  currency      String      @default("SAR") @db.Char(3)
  deliveryLabel String      @map("delivery_label")
  includes      Json
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  offering ServiceOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@unique([offeringId, tier])
  @@map("service_packages")
}

model ServiceAddon {
  id         String   @id @default(uuid()) @db.Uuid
  offeringId String   @map("offering_id") @db.Uuid
  title      String
  price      Decimal  @db.Decimal(12, 2)
  currency   String   @default("SAR") @db.Char(3)
  position   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  offering ServiceOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@index([offeringId, position])
  @@map("service_addons")
}

model ServiceMedia {
  id           String   @id @default(uuid()) @db.Uuid
  offeringId   String   @map("offering_id") @db.Uuid
  mediaAssetId String   @map("media_asset_id") @db.Uuid
  position     Int
  isVideo      Boolean  @default(false) @map("is_video")
  createdAt    DateTime @default(now()) @map("created_at")

  offering   ServiceOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset      @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@unique([offeringId, mediaAssetId])
  @@index([offeringId, position])
  @@map("service_media")
}

model JobListing {
  id             String           @id @default(uuid()) @db.Uuid
  posterId       String           @map("poster_id") @db.Uuid
  title          String
  companyName    String?          @map("company_name")
  employmentType EmploymentType   @map("employment_type")
  location       String
  salaryLabel    String?          @map("salary_label")
  description    String           @default("")
  skills         String[]         @default([])
  exploreTag     String?          @map("explore_tag")
  status         JobListingStatus @default(draft)
  postedAt       DateTime?        @map("posted_at")
  deletedAt      DateTime?        @map("deleted_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  poster       User             @relation("JobListingPoster", fields: [posterId], references: [id], onDelete: Cascade)
  applications JobApplication[]
  engagements  WorkEngagement[]
  workRequests WorkRequest[]

  @@index([status, postedAt(sort: Desc)])
  @@index([posterId, status])
  @@index([exploreTag])
  @@map("job_listings")
}

model JobApplication {
  id          String               @id @default(uuid()) @db.Uuid
  listingId   String               @map("listing_id") @db.Uuid
  applicantId String               @map("applicant_id") @db.Uuid
  coverLetter String               @default("") @map("cover_letter")
  status      JobApplicationStatus @default(submitted)
  deletedAt   DateTime?            @map("deleted_at")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  listing     JobListing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  applicant   User            @relation("JobApplicationApplicant", fields: [applicantId], references: [id], onDelete: Cascade)
  engagement  WorkEngagement?
  workRequest WorkRequest?

  @@unique([listingId, applicantId])
  @@index([listingId, status])
  @@index([applicantId, status])
  @@map("job_applications")
}

model WorkEngagement {
  id                String               @id @default(uuid()) @db.Uuid
  listingId         String?              @map("listing_id") @db.Uuid
  applicationId     String?              @unique @map("application_id") @db.Uuid
  serviceOfferingId String?              @map("service_offering_id") @db.Uuid
  clientId          String               @map("client_id") @db.Uuid
  providerId        String               @map("provider_id") @db.Uuid
  title             String
  status            WorkEngagementStatus
  source            WorkEngagementSource
  dueAt             DateTime?            @map("due_at")
  deletedAt         DateTime?            @map("deleted_at")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  listing         JobListing?       @relation(fields: [listingId], references: [id], onDelete: SetNull)
  application     JobApplication?   @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  serviceOffering ServiceOffering?  @relation(fields: [serviceOfferingId], references: [id], onDelete: SetNull)
  client          User              @relation("EngagementClient", fields: [clientId], references: [id], onDelete: Cascade)
  provider        User              @relation("EngagementProvider", fields: [providerId], references: [id], onDelete: Cascade)
  detail          EngagementDetail?
  events          EngagementEvent[]
  reviews         EngagementReview[]
  workRequest     WorkRequest?
  conversation    Conversation?

  @@index([clientId, status])
  @@index([providerId, status])
  @@index([listingId])
  @@index([status, updatedAt])
  @@map("work_engagements")
}

/// Minimal Phase 4 bridge — full reviews product comes later.
/// Submitting a review archives the work conversation for that reviewer.
model EngagementReview {
  id           String   @id @default(uuid()) @db.Uuid
  engagementId String   @map("engagement_id") @db.Uuid
  reviewerId   String   @map("reviewer_id") @db.Uuid
  /// 1–5 star rating
  rating       Int
  body         String   @default("")
  createdAt    DateTime @default(now()) @map("created_at")

  engagement WorkEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  reviewer   User           @relation("EngagementReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([engagementId, reviewerId])
  @@index([reviewerId])
  @@index([engagementId])
  @@map("engagement_reviews")
}

model EngagementDetail {
  engagementId    String   @id @map("engagement_id") @db.Uuid
  serviceName     String   @default("") @map("service_name")
  packageName     String   @default("") @map("package_name")
  packagePrice    Decimal  @default(0) @map("package_price") @db.Decimal(12, 2)
  currency        String   @default("SAR") @db.Char(3)
  addons          Json     @default("[]")
  deadlineLabel   String?  @map("deadline_label")
  locationUrl     String?  @map("location_url")
  locationCity    String?  @map("location_city")
  locationCountry String?  @map("location_country")
  locationDetails String?  @map("location_details")
  notes           String   @default("")
  coverLetter     String   @default("") @map("cover_letter")
  requestedAt     DateTime @default(now()) @map("requested_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  engagement WorkEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  @@map("engagement_details")
}

model EngagementEvent {
  id           String                @id @default(uuid()) @db.Uuid
  engagementId String                @map("engagement_id") @db.Uuid
  fromStatus   WorkEngagementStatus? @map("from_status")
  toStatus     WorkEngagementStatus  @map("to_status")
  actorId      String?               @map("actor_id") @db.Uuid
  note         String                @default("")
  createdAt    DateTime              @default(now()) @map("created_at")

  engagement WorkEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  @@index([engagementId, createdAt])
  @@map("engagement_events")
}

/// Unified Jobs inbox entity. Every negotiation (job application, service
/// request, direct request) is a WorkRequest; JobListing / JobApplication /
/// WorkEngagement stay as source links.
model WorkRequest {
  id                    String            @id @default(uuid()) @db.Uuid
  source                WorkRequestSource
  /// Direction — Sent (senderUserId) / Received (recipientUserId)
  senderUserId          String            @map("sender_user_id") @db.Uuid
  recipientUserId       String            @map("recipient_user_id") @db.Uuid
  /// Commercial roles — who pays (client) and who delivers (provider)
  clientUserId          String            @map("client_user_id") @db.Uuid
  providerUserId        String            @map("provider_user_id") @db.Uuid
  jobListingId          String?           @map("job_listing_id") @db.Uuid
  jobApplicationId      String?           @unique @map("job_application_id") @db.Uuid
  serviceOfferingId     String?           @map("service_offering_id") @db.Uuid
  /// Set when the engagement is created on accept
  workEngagementId      String?           @unique @map("work_engagement_id") @db.Uuid
  title                 String
  status                WorkRequestStatus @default(pending)
  /// Original terms snapshot at creation time
  termsJson             Json              @map("terms_json")
  proposedTermsJson     Json?             @map("proposed_terms_json")
  agreedTermsJson       Json?             @map("agreed_terms_json")
  proposedByUserId      String?           @map("proposed_by_user_id") @db.Uuid
  proposalComment       String            @default("") @map("proposal_comment")
  rejectionComment      String            @default("") @map("rejection_comment")
  senderLastViewedAt    DateTime?         @map("sender_last_viewed_at")
  recipientLastViewedAt DateTime?         @map("recipient_last_viewed_at")
  deletedAt             DateTime?         @map("deleted_at")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  sender          User               @relation("WorkRequestSender", fields: [senderUserId], references: [id], onDelete: Cascade)
  recipient       User               @relation("WorkRequestRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  client          User               @relation("WorkRequestClient", fields: [clientUserId], references: [id], onDelete: Cascade)
  provider        User               @relation("WorkRequestProvider", fields: [providerUserId], references: [id], onDelete: Cascade)
  jobListing      JobListing?        @relation(fields: [jobListingId], references: [id], onDelete: SetNull)
  jobApplication  JobApplication?    @relation(fields: [jobApplicationId], references: [id], onDelete: SetNull)
  serviceOffering ServiceOffering?   @relation(fields: [serviceOfferingId], references: [id], onDelete: SetNull)
  workEngagement  WorkEngagement?    @relation(fields: [workEngagementId], references: [id], onDelete: SetNull)
  events          WorkRequestEvent[]

  @@index([senderUserId, status])
  @@index([recipientUserId, status])
  @@index([updatedAt])
  @@index([jobListingId, status])
  @@map("work_requests")
}

model WorkRequestEvent {
  id            String               @id @default(uuid()) @db.Uuid
  workRequestId String               @map("work_request_id") @db.Uuid
  type          WorkRequestEventType
  actorId       String?              @map("actor_id") @db.Uuid
  fromStatus    WorkRequestStatus?   @map("from_status")
  toStatus      WorkRequestStatus?   @map("to_status")
  note          String               @default("")
  payload       Json?
  createdAt     DateTime             @default(now()) @map("created_at")

  workRequest WorkRequest @relation(fields: [workRequestId], references: [id], onDelete: Cascade)

  @@index([workRequestId, createdAt])
  @@map("work_request_events")
}

// ---------------------------------------------------------------------------
// Phase 4 — Connections, Messaging, Notifications
// ---------------------------------------------------------------------------

model ConnectionRequest {
  id         String                  @id @default(uuid()) @db.Uuid
  fromUserId String                  @map("from_user_id") @db.Uuid
  toUserId   String                  @map("to_user_id") @db.Uuid
  status     ConnectionRequestStatus @default(pending)
  message    String                  @default("")
  createdAt  DateTime                @default(now()) @map("created_at")
  updatedAt  DateTime                @updatedAt @map("updated_at")

  fromUser User @relation("ConnectionRequestFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("ConnectionRequestTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([toUserId, status])
  @@index([fromUserId, status])
  @@map("connection_requests")
}

/// Undirected accepted edge. userLowId < userHighId lexicographically.
model Connection {
  id         String    @id @default(uuid()) @db.Uuid
  userLowId  String    @map("user_low_id") @db.Uuid
  userHighId String    @map("user_high_id") @db.Uuid
  /// Soft end — conversation history is retained; chat becomes read-only.
  endedAt    DateTime? @map("ended_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  userLow      User          @relation("ConnectionUserLow", fields: [userLowId], references: [id], onDelete: Cascade)
  userHigh     User          @relation("ConnectionUserHigh", fields: [userHighId], references: [id], onDelete: Cascade)
  conversation Conversation?

  @@unique([userLowId, userHighId])
  @@index([userLowId, endedAt])
  @@index([userHighId, endedAt])
  @@map("connections")
}

model Conversation {
  id                String           @id @default(uuid()) @db.Uuid
  type              ConversationType
  connectionId      String?          @unique @map("connection_id") @db.Uuid
  workEngagementId  String?          @unique @map("work_engagement_id") @db.Uuid
  /// When set, conversation is archived (history retained, typically read-only).
  archivedAt        DateTime?        @map("archived_at")
  lastMessageAt     DateTime?        @map("last_message_at")
  lastMessagePreview String          @default("") @map("last_message_preview")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  connection     Connection?               @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  workEngagement WorkEngagement?           @relation(fields: [workEngagementId], references: [id], onDelete: Cascade)
  participants   ConversationParticipant[]
  messages       Message[]

  @@index([type, updatedAt])
  @@index([lastMessageAt])
  @@map("conversations")
}

model ConversationParticipant {
  id              String    @id @default(uuid()) @db.Uuid
  conversationId  String    @map("conversation_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  lastReadAt      DateTime? @map("last_read_at")
  /// Watermark for inbox/thread delivery (Sent → Delivered). Read implies delivered.
  lastDeliveredAt DateTime? @map("last_delivered_at")
  mutedAt         DateTime? @map("muted_at")
  /// User-specific archive (hides from inbox; visible under archived scope).
  archivedAt      DateTime? @map("archived_at")
  /// User-specific soft hide (excluded from inbox and archived lists).
  deletedAt       DateTime? @map("deleted_at")
  joinedAt        DateTime  @default(now()) @map("joined_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, deletedAt, archivedAt])
  @@map("conversation_participants")
}

model Message {
  id               String      @id @default(uuid()) @db.Uuid
  conversationId   String      @map("conversation_id") @db.Uuid
  /// Null for system messages.
  senderId         String?     @map("sender_id") @db.Uuid
  kind             MessageKind @default(user)
  body             String      @default("")
  /// Client-supplied idempotency key for retries.
  clientMessageId  String?     @map("client_message_id")
  /// System message metadata (e.g. engagement status event).
  systemPayload    Json?       @map("system_payload")
  createdAt        DateTime    @default(now()) @map("created_at")

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?               @relation("MessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  attachments  MessageAttachment[]

  @@unique([conversationId, clientMessageId])
  @@index([conversationId, createdAt])
  @@map("messages")
}

model MessageAttachment {
  id            String @id @default(uuid()) @db.Uuid
  messageId     String @map("message_id") @db.Uuid
  mediaAssetId  String @map("media_asset_id") @db.Uuid
  position      Int    @default(0)

  message    Message    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@unique([messageId, mediaAssetId])
  @@index([mediaAssetId])
  @@map("message_attachments")
}

model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  recipientId String           @map("recipient_id") @db.Uuid
  actorId     String?          @map("actor_id") @db.Uuid
  type        NotificationType
  title       String
  body        String           @default("")
  /// Deep-link payload: { screen, params }
  payload     Json             @default("{}")
  readAt      DateTime?        @map("read_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  recipient User  @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([recipientId, createdAt])
  @@index([recipientId, readAt])
  @@map("notifications")
}

