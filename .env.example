# =============================================================================
# Mawahib Backend — environment reference (local + Railway)
# =============================================================================
# Copy to `.env` for local development. Never commit `.env` with real secrets.
# Railway: set the same variable NAMES in the service Variables panel.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------

# REQUIRED (recommended). Local: development | Railway: production | Tests: test
# Used by Nest config validation and runtime behavior.
NODE_ENV=development

# OPTIONAL locally (defaults to 3000). Railway injects PORT automatically —
# do not hardcode Railway's port. Nest listens on process.env.PORT.
PORT=3000

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------

# OPTIONAL (has localhost defaults in code if unset). Comma-separated browser
# origins allowed by Nest `enableCors`. Native React Native usually ignores CORS.
# Expo web / Metro examples: http://localhost:8081,http://localhost:19006
# Add future admin/web origins explicitly. Do NOT use *.
# Never commit production origins with secrets (origins are not secrets, but keep tight).
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase Project
# -----------------------------------------------------------------------------

# REQUIRED (non-test). Project reference / id used in env validation.
# Where: Supabase Dashboard → Project Settings → General → Reference ID
# Safe to document as a public project ref; still prefer placeholders in shared copies.
SUPABASE_PROJECT_ID=your-project-ref

# REQUIRED (non-test). Base URL for Supabase Auth/API and JWKS derivation.
# Where: Supabase Dashboard → Project Settings → API → Project URL
# Example shape: https://your-project-ref.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# OPTIONAL for Nest (not in REQUIRED_IN_RUNTIME). Publishable / anon key.
# Where: Supabase Dashboard → Project Settings → API → Publishable / anon key
# Safe for frontend (EXPO_PUBLIC_*). Do NOT use for privileged server operations.
# NEVER commit a real key if your org treats publishable keys as restricted.
SUPABASE_PUBLISHABLE_KEY=

# REQUIRED (non-test). SERVER ONLY. Never put in the React Native / Expo app.
# Where: Supabase Dashboard → Project Settings → API → Secret / service_role key
# NEVER commit a real value. Railway Variable only.
SUPABASE_SECRET_KEY=

# -----------------------------------------------------------------------------
# Database (Prisma → PostgreSQL)
# -----------------------------------------------------------------------------

# REQUIRED (non-test). Prisma connection string to the SAME Supabase Postgres.
# Where: Supabase Dashboard → Project Settings → Database → Connection string → URI
# Prefer Session pooler (Session mode) or Direct connection on port 5432 for
# long-running Nest + Prisma on Railway.
# Transaction pooler (port 6543) only if necessary; then add Prisma-compatible
# params such as ?pgbouncer=true.
# URL-encode special characters in the DB password.
# Railway should use this Supabase DATABASE_URL — do not create a separate
# Railway Postgres for Mawahib domain data.
# NEVER commit a real password / full connection string.
DATABASE_URL=

# -----------------------------------------------------------------------------
# Supabase Auth (JWT verification)
# -----------------------------------------------------------------------------

# OPTIONAL if SUPABASE_URL is set — Nest auto-derives:
#   {SUPABASE_URL}/auth/v1/.well-known/jwks.json
# Preferred for asymmetric JWT verification (JWKS).
# Example: https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_JWKS_URL=

# OPTIONAL fallback when JWKS is unavailable. Prefer JWKS over this secret.
# Where: Supabase Dashboard → Project Settings → API → JWT Secret
# Do not require both JWKS URL and JWT secret. SERVER-oriented secret —
# NEVER commit a real value.
SUPABASE_JWT_SECRET=

# -----------------------------------------------------------------------------
# Development Seed (local only)
# -----------------------------------------------------------------------------

# DEVELOPMENT ONLY. Not part of Nest runtime validateEnv schema.
# Used only by `npm run seed:dev` (prisma/seed-dev.ts).
# NEVER set these on Railway production.
# NEVER run `npm run seed:dev` on the Railway production service.
# ALLOW_DEV_SEED=true
# DEV_SEED_PASSWORD=

# -----------------------------------------------------------------------------
# Railway deployment notes
# -----------------------------------------------------------------------------
# NODE_ENV=production
# PORT is injected automatically by Railway — leave unset or do not override casually
# Use Supabase DATABASE_URL; do not create a Railway DB for Mawahib
# Do not set ALLOW_DEV_SEED / DEV_SEED_PASSWORD
# Health endpoint: /api/v1/health
# Build: npm run build | Pre-Deploy: npx prisma migrate deploy | Start: npm run start:prod
