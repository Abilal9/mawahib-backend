# Environment
NODE_ENV=development
PORT=3000

# Comma-separated origins for CORS (React Native Metro / Expo / web)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000

# Direct PostgreSQL connection to Supabase Postgres (Prisma).
# Dashboard → Project Settings → Database → Connection string → URI
# Use the "Transaction" pooler (port 6543) for serverless, or "Session"/direct (5432) for local Nest.
# Leave empty until credentials are available — health will report db as not_configured.
DATABASE_URL=

# Supabase project URL (Dashboard → Project Settings → API → Project URL)
SUPABASE_URL=

# Supabase anon/public key (Dashboard → Project Settings → API → anon public)
# Safe for frontend; Nest keeps a copy for JWKS / client helpers.
SUPABASE_ANON_KEY=

# Supabase service role key (Dashboard → Project Settings → API → service_role)
# MUST stay server-side only. Used later for admin Auth/Storage operations.
SUPABASE_SERVICE_ROLE_KEY=

# JWT verification (choose one approach when implementing auth fully)
# Dashboard → Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=

# Or JWKS URL for asymmetric JWT verification (Supabase Auth)
# Typically: https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_JWKS_URL=
