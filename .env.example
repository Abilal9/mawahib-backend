NODE_ENV=development
PORT=3000

# Comma-separated origins for CORS (React Native Metro / Expo / web)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000

SUPABASE_PROJECT_ID=mrtsjgrsponzqrzptymg
SUPABASE_URL=https://mrtsjgrsponzqrzptymg.supabase.co

# Dashboard → Project Settings → API → Publishable / anon key (safe for frontend)
SUPABASE_PUBLISHABLE_KEY=

# Dashboard → Project Settings → API → Secret / service_role key (SERVER ONLY)
SUPABASE_SECRET_KEY=

# Dashboard → Project Settings → Database → Connection string (URI)
# Prefer Session mode / direct for Nest + Prisma (port 5432), or Transaction pooler (6543) with ?pgbouncer=true
DATABASE_URL=

# Optional — JWT verification for protected routes (Auth foundation)
# Dashboard → Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=

# Preferred JWKS URL for asymmetric JWT verification (auto-derived from SUPABASE_URL if empty)
# https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_JWKS_URL=
