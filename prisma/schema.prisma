// Phase 1–2 schema. Later phases add jobs, messaging, etc. per BACKEND_BLUEPRINT.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  talent
  business
}

enum MediaStatus {
  pending
  ready
  failed
}

enum MediaPurpose {
  avatar
  portfolio
  service
}

enum ServiceOfferingStatus {
  draft
  published
  archived
}

enum PackageTier {
  basic
  standard
  premium
}

model User {
  id             String      @id @db.Uuid
  email          String      @unique @db.Citext
  accountType    AccountType @map("account_type")
  displayName    String      @map("display_name")
  username       String      @unique @db.Citext
  isVerified     Boolean     @default(false) @map("is_verified")
  followersCount Int         @default(0) @map("followers_count")
  followingCount Int         @default(0) @map("following_count")
  postsCount     Int         @default(0) @map("posts_count")
  ratingAvg      Decimal     @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount    Int         @default(0) @map("rating_count")
  deletedAt      DateTime?   @map("deleted_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  profile            Profile?
  skills             UserSkill[]
  mediaAssets        MediaAsset[]
  portfolioProjects  PortfolioProject[]
  serviceOfferings   ServiceOffering[]

  @@index([accountType])
  @@map("users")
}

model Profile {
  userId          String   @id @map("user_id") @db.Uuid
  bio             String   @default("")
  title           String?
  locationCity    String?  @map("location_city")
  locationCountry String?  @map("location_country")
  avatarUrl       String?  @map("avatar_url")
  coverUrl        String?  @map("cover_url")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model UserSkill {
  userId    String   @map("user_id") @db.Uuid
  skill     String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, skill])
  @@index([skill])
  @@map("user_skills")
}

model MediaAsset {
  id        String       @id @default(uuid()) @db.Uuid
  ownerId   String       @map("owner_id") @db.Uuid
  bucket    String
  objectKey String       @map("object_key")
  mimeType  String       @map("mime_type")
  byteSize  BigInt       @map("byte_size")
  width     Int?
  height    Int?
  purpose   MediaPurpose
  status    MediaStatus  @default(pending)
  deletedAt DateTime?    @map("deleted_at")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  owner          User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  portfolioMedia PortfolioMedia[]
  serviceMedia   ServiceMedia[]

  @@unique([bucket, objectKey])
  @@index([ownerId, status])
  @@map("media_assets")
}

model PortfolioProject {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  title       String
  description String    @default("")
  position    Int       @default(0)
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  media PortfolioMedia[]

  @@index([userId, position])
  @@map("portfolio_projects")
}

model PortfolioMedia {
  id           String   @id @default(uuid()) @db.Uuid
  projectId    String   @map("project_id") @db.Uuid
  mediaAssetId String   @map("media_asset_id") @db.Uuid
  position     Int
  isVideo      Boolean  @default(false) @map("is_video")
  createdAt    DateTime @default(now()) @map("created_at")

  project    PortfolioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset       @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@unique([projectId, mediaAssetId])
  @@index([projectId, position])
  @@map("portfolio_media")
}

model ServiceOffering {
  id          String                @id @default(uuid()) @db.Uuid
  userId      String                @map("user_id") @db.Uuid
  title       String
  description String                @default("")
  category    String?
  status      ServiceOfferingStatus @default(published)
  ratingAvg   Decimal               @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount Int                   @default(0) @map("rating_count")
  currency    String                @default("SAR") @db.Char(3)
  position    Int                   @default(0)
  deletedAt   DateTime?             @map("deleted_at")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  packages ServicePackage[]
  addons   ServiceAddon[]
  media    ServiceMedia[]

  @@index([userId, status])
  @@index([userId, position])
  @@map("service_offerings")
}

model ServicePackage {
  id            String      @id @default(uuid()) @db.Uuid
  offeringId    String      @map("offering_id") @db.Uuid
  tier          PackageTier
  price         Decimal     @db.Decimal(12, 2)
  currency      String      @default("SAR") @db.Char(3)
  deliveryLabel String      @map("delivery_label")
  includes      Json
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  offering ServiceOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@unique([offeringId, tier])
  @@map("service_packages")
}

model ServiceAddon {
  id         String   @id @default(uuid()) @db.Uuid
  offeringId String   @map("offering_id") @db.Uuid
  title      String
  price      Decimal  @db.Decimal(12, 2)
  currency   String   @default("SAR") @db.Char(3)
  position   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  offering ServiceOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@index([offeringId, position])
  @@map("service_addons")
}

model ServiceMedia {
  id           String   @id @default(uuid()) @db.Uuid
  offeringId   String   @map("offering_id") @db.Uuid
  mediaAssetId String   @map("media_asset_id") @db.Uuid
  position     Int
  isVideo      Boolean  @default(false) @map("is_video")
  createdAt    DateTime @default(now()) @map("created_at")

  offering   ServiceOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset      @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@unique([offeringId, mediaAssetId])
  @@index([offeringId, position])
  @@map("service_media")
}
